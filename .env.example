# Copy to .env for local use. Never commit real values. Set these in Render's dashboard for production.

# Required for API access. Generate with: openssl rand -hex 32 (each key at least 16 characters).
API_KEYS=replace-with-a-long-random-key

# Required for the web page lookup: the access password and the cookie signing secret (32+ characters).
UI_PASSWORD=replace-with-a-password-of-12-plus-chars
SESSION_SECRET=replace-with-a-random-string-of-32-plus-characters

# Comma-separated browser origins allowed to call the API (leave empty for server-to-server only).
CORS_ORIGINS=

# http (default, plain fetch) or browser (headless Chromium, used by the Docker build).
FETCH_MODE=browser

# Keep off in production. When true, /api/public/debug needs an API key and still hides HTML.
ENABLE_DEBUG_ENDPOINT=false

# Set to false to turn off the web page lookup entirely.
ENABLE_WEB_LOOKUP=true

# Price cache and limits.
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=200
MAX_CONCURRENT_SCRAPES=1
MAX_QUEUED_SCRAPES=4
BLOCK_COOLDOWN_SECONDS=300
REQUEST_TIMEOUT_SECONDS=45
BROWSER_IDLE_SECONDS=120
